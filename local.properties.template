# Copy this file to local.properties and fill in the values.
# local.properties is excluded from version control.

# Android SDK path — set automatically by Android Studio
sdk.dir=/Users/<your-username>/Library/Android/sdk

# Release signing — required only to produce a signed release build / AAB.
# Generate a keystore with: keytool -genkey -v -keystore cvp-release.jks -alias cvp -keyalg RSA -keysize 2048 -validity 10000
# Then fill in the paths and credentials below.
STORE_FILE=../cvp-release.jks
STORE_PASSWORD=your_keystore_password
KEY_ALIAS=cvp
KEY_PASSWORD=your_key_password
